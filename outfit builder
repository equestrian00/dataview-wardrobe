async function logOutfit(date, paths) {
    if (!paths.length) return;
    const pages = paths.map(p => pageByPath[p]).filter(Boolean);
    let updated = 0;
    try {
        for (const page of pages) {
            const tfile = app.vault.getAbstractFileByPath(page.file.path);
            if (!tfile) continue;
            const others = pages
                .filter(p => p.file.path !== page.file.path)
                .map(p => `[[${p.file.name.replace(/\.md$/, "")}]]`)
                .join(", ");
            await app.fileManager.processFrontMatter(tfile, fm => {
                const wearKey = "wear_count";
                fm[wearKey] = (parseInt(fm[wearKey]) || 0) + 1;
                if (!fm.outfits)                   fm.outfits = [];
                if (!Array.isArray(fm.outfits))    fm.outfits = [fm.outfits];
                fm.outfits.push(`${date}: Worn with ${others}`);
            });
            updated++;
        }
        showToast(`Logged for ${date} — ${updated} item${updated !== 1 ? "s" : ""} updated.`);
    } catch (e) {
        showToast(`Could not log: ${e.message}`, true);
        console.error("[Outfit Builder] logOutfit error:", e);
    }
}

