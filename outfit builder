//  🏗  COMPONENT BUILDERS
// ═══════════════════════════════════════════════════════════════

// ── Tiny image card (search result) ─────────────────────────
function buildSearchCard(page) {
    const imgSrc  = resolveImage(fk(page, "image"));
    const name    = displayName(page);
    const isAdded = state.selected.includes(page.file.path);

    const card = make("div", "wb-search-card" + (isAdded ? " wb-search-card--added" : ""));
    card.title = name;

    const img = make("div", "wb-search-card__img");
    if (imgSrc) img.style.backgroundImage = `url('${imgSrc}')`;
    else img.innerHTML = `<span class="wb-card__no-img">✦</span>`;
    card.appendChild(img);

    const label = txt("div", "wb-search-card__label", name);
    card.appendChild(label);

    if (isAdded) {
        const check = txt("div", "wb-search-card__check", "✓");
        card.appendChild(check);
    }

    // Leading debounce: fires immediately on first click, ignores rapid repeats.
    // Prevents double-clicking a card from toggling it off straight away.
    // 700ms window gives enough time to move from a card to Save without interference.
    const handleCardClick = debounce(() => {
        if (state.selected.includes(page.file.path)) {
            state.selected = state.selected.filter(p => p !== page.file.path);
        } else {
            state.selected.push(page.file.path);
        }
        saveDraft();
        render();
    }, 5000, { leading: true });

    card.addEventListener("click", handleCardClick);

    return card;
}

// ── Canvas item card ─────────────────────────────────────────
function buildCanvasCard(filePath) {
    const page   = pageByPath[filePath];
    if (!page) return null;
    const imgSrc = resolveImage(fk(page, "image"));
    const name   = displayName(page);

    const wrap = make("div", "wb-canvas-item");

    const card = make("div", "wb-canvas-card");
    card.title = name;

    const img = make("div", "wb-canvas-card__img");
    if (imgSrc) img.style.backgroundImage = `url('${imgSrc}')`;
    else img.innerHTML = `<span class="wb-card__no-img">✦</span>`;
    card.appendChild(img);

    // Remove button — appears on hover
    const rmBtn = make("button", "wb-canvas-card__remove");
    rmBtn.textContent = "×";
    rmBtn.title = "Remove from outfit";
    rmBtn.onclick = e => {
        e.stopPropagation();
        state.selected = state.selected.filter(p => p !== filePath);
        saveDraft();
        render();
    };
    card.appendChild(rmBtn);

    wrap.appendChild(card);
    wrap.appendChild(txt("div", "wb-canvas-item__label", name));
    return wrap;
}

// ── Tag picker ──────────────────────────────────────────────
/**
 * Build the mood / occasion / season tag picker shown below the canvas row.
 * Tags that appear on at least one item in the current outfit are marked
 * "outfit-present" so they render distinctly from unrelated vault tags.
 */
function buildTagPicker() {
    // Collect tags present on the outfit's items
    const presentMoods     = new Set();
    const presentOccasions = new Set();
    const presentSeasons   = new Set();
    state.selected.forEach(path => {
        const p = pageByPath[path];
        if (!p) return;
        (Array.isArray(p.mood)     ? p.mood     : [p.mood])    .forEach(v => v && presentMoods.add(toTitleCase(String(v).trim())));
        (Array.isArray(p.occasion) ? p.occasion : [p.occasion]).forEach(v => v && presentOccasions.add(toTitleCase(String(v).trim())));
        (Array.isArray(p.season)   ? p.season   : [p.season])  .forEach(v => v && presentSeasons.add(toTitleCase(String(v).trim())));
    });

    const wrap = make("div", "wb-tag-picker");

    function buildGroup(label, allVals, presentSet, selectedArr) {
        if (!allVals.length) return;
        const group = make("div", "wb-tag-group");
        group.appendChild(txt("span", "wb-tag-group__label", label));
        const pills = make("div", "wb-tag-pills");

        allVals.forEach(val => {
            const isPresent  = presentSet.has(val);
            const isSelected = selectedArr.includes(val);
            let cls = "wb-tag-pill";
            if (isPresent)  cls += " wb-tag-pill--present";
            if (isSelected) cls += " wb-tag-pill--on";
            const pill = txt("button", cls, val);
            pill.onclick = () => {
                const idx = selectedArr.indexOf(val);
                if (idx >= 0) selectedArr.splice(idx, 1);
                else          selectedArr.push(val);
                // Re-render only the tag picker area
                const existing = ROOT.querySelector(".wb-tag-picker");
                if (existing) existing.replaceWith(buildTagPicker());
            };
            pills.appendChild(pill);
        });

        group.appendChild(pills);
        wrap.appendChild(group);
    }

    buildGroup("Mood",     ALL_MOODS,     presentMoods,     state.selectedTags.mood);
    buildGroup("Occasion", ALL_OCCASIONS, presentOccasions, state.selectedTags.occasion);
    buildGroup("Season",   ALL_SEASONS,   presentSeasons,   state.selectedTags.season);

    return wrap;
}

// ── Saved outfit thumbnail ───────────────────────────────────
function buildSavedCard(outfit, index) {
    const card = make("div", "wb-saved-card");

    // Thumbnail strip — up to 4 images
    const thumbs = make("div", "wb-saved-card__thumbs");
    outfit.items.slice(0, 4).forEach(path => {
        const page = pageByPath[path];
        const img  = make("div", "wb-saved-card__thumb");
        if (page) {
            const src = resolveImage(fk(page, "image"));
            if (src) img.style.backgroundImage = `url('${src}')`;
            else img.innerHTML = `<span class="wb-card__no-img" style="font-size:9px">✦</span>`;
        }
        thumbs.appendChild(img);
    });
    card.appendChild(thumbs);

    const info = make("div", "wb-saved-card__info");

    // Left: name + meta stacked
    const infoLeft = make("div", "wb-saved-card__info-left");
    infoLeft.appendChild(txt("div", "wb-saved-card__name", outfit.name || "Untitled"));
    const meta = txt("div", "wb-saved-card__meta",
        `${outfit.items.length} item${outfit.items.length !== 1 ? "s" : ""}  ·  ${outfit.date || ""}`);
    infoLeft.appendChild(meta);
    info.appendChild(infoLeft);

    // Right: + and × as unobtrusive icon buttons always visible
    const infoActions = make("div", "wb-saved-card__info-actions");

    const addToColBtn = make("button", "wb-saved-icon-btn");
    addToColBtn.textContent = "+";
    addToColBtn.title = "Add to a collection";
    addToColBtn.onclick = e => {
        e.stopPropagation();
        ROOT.querySelectorAll(".wb-col-menu").forEach(m => m.remove());
        if (!state.collections.length) {
            showToast("Create a collection first.");
            return;
        }
        const menu = make("div", "wb-col-menu");
        state.collections.forEach((col, ci) => {
            const already = (col.outfitIds || []).includes(outfit.id);
            const item = make("div", "wb-col-menu-item" + (already ? " wb-col-menu-item--in" : ""));
            item.textContent = (already ? "✓  " : "") + col.name;
            item.onclick = async ev => {
                ev.stopPropagation();
                menu.remove();
                if (already) {
                    state.collections[ci].outfitIds =
                        (col.outfitIds || []).filter(id => id !== outfit.id);
                    showToast(`Removed from "${col.name}".`);
                } else {
                    state.collections[ci].outfitIds = [...(col.outfitIds || []), outfit.id];
                    showToast(`Added to "${col.name}".`);
                }
                await persistCollections(state.collections);
                render();
            };
            menu.appendChild(item);
        });
        ROOT.style.position = "relative";
        const btnRect  = addToColBtn.getBoundingClientRect();
        const rootRect = ROOT.getBoundingClientRect();
        menu.style.position = "absolute";
        menu.style.top  = (btnRect.bottom - rootRect.top + 4) + "px";
        menu.style.left = (btnRect.left   - rootRect.left)    + "px";
        ROOT.appendChild(menu);
        setTimeout(() => document.addEventListener("click", () => menu.remove(), { once: true }), 0);
    };

    const delBtn = make("button", "wb-saved-icon-btn wb-saved-icon-btn--del");
    delBtn.textContent = "×";
    delBtn.title = "Delete this outfit";
    delBtn.onclick = async e => {
        e.stopPropagation();
        const deletedId = outfit.id;
        state.savedOutfits.splice(index, 1);
        // Remove this outfit's id from any collections it belonged to
        state.collections.forEach(col => {
            col.outfitIds = (col.outfitIds || []).filter(id => id !== deletedId);
        });
        await Promise.all([
            persistSavedOutfits(state.savedOutfits),
            persistCollections(state.collections),
        ]);
        showToast("Outfit deleted.");
        render();
    };

    infoActions.appendChild(addToColBtn);
    infoActions.appendChild(delBtn);
    info.appendChild(infoActions);
    card.appendChild(info);

    // Tag chips
    if (outfit.tags) {
        const tagChips = make("div", "wb-saved-card__tags");
        const allTagVals = [
            ...(outfit.tags.mood     || []),
            ...(outfit.tags.occasion || []),
            ...(outfit.tags.season   || []),
        ];
        allTagVals.forEach(t => tagChips.appendChild(txt("span", "wb-saved-tag", t)));
        if (allTagVals.length) card.appendChild(tagChips);
    }

    // Hover actions: Load + date/log only
    const actions = make("div", "wb-saved-card__actions");

    const loadBtn = make("button", "wb-btn--load");
    loadBtn.textContent = "↩";
    loadBtn.title = "Load into builder";
    loadBtn.onclick = e => {
        e.stopPropagation();
        state.selected     = [...outfit.items];
        state.outfitName   = outfit.name || "";
        state.selectedTags = {
            mood:     [...(outfit.tags?.mood     || [])],
            occasion: [...(outfit.tags?.occasion || [])],
            season:   [...(outfit.tags?.season   || [])],
        };
        state.editingIndex = index;
        render();
        ROOT.querySelector(".wb-canvas")?.scrollIntoView({ behavior: "smooth" });
    };
    actions.appendChild(loadBtn);

    const savedLogWrap = make("div", "wb-log-wrap wb-log-wrap--saved");
    const savedDateInput = make("input", "wb-date-input wb-date-input--saved");
    savedDateInput.type  = "date";
    savedDateInput.value = new Date().toLocaleDateString("en-CA");
    savedDateInput.onclick = e => e.stopPropagation();
    savedLogWrap.appendChild(savedDateInput);

    const savedLogBtn = make("button", "wb-btn--log-saved");
    savedLogBtn.textContent = "Log";
    savedLogBtn.onclick = async e => {
        e.stopPropagation();
        const date = savedDateInput.value || new Date().toLocaleDateString("en-CA");
        await logOutfit(date, outfit.items);
    };
    savedLogWrap.appendChild(savedLogBtn);
    actions.appendChild(savedLogWrap);

    card.appendChild(actions);

    return card;
}

// ═══════════════════════════════════════════════════════════════
//  📁  COLLECTIONS
// ═══════════════════════════════════════════════════════════════

function buildCollectionCard(col, colIndex) {
    const isExpanded = state.expandedCollectionId === col.id;
    // Resolve outfit objects in this collection
    const colOutfits = (col.outfitIds || [])
        .map(id => state.savedOutfits.find(o => o.id === id))
        .filter(Boolean);

    const card = make("div", "wb-col-card" + (isExpanded ? " wb-col-card--open" : ""));

    // ── Header ──────────────────────────────────────────────────
    const header = make("div", "wb-col-card__header");

    const chevron = make("span", "wb-col-card__chevron");
    chevron.textContent = "›";

    // Editable name
    const nameEl = make("div", "wb-col-card__name");
    nameEl.textContent = col.name || "Untitled Collection";
    nameEl.contentEditable = "true";
    nameEl.spellcheck = false;

    // Debounced persist — write fires 600ms after the last keystroke settles,
    // not on every character. State is updated synchronously so any render()
    // triggered by a simultaneous header click sees the new name immediately.
    const debouncedPersistName = debounce(async () => {
        await persistCollections(state.collections);
    }, 600);

    nameEl.addEventListener("click", e => e.stopPropagation());
    nameEl.addEventListener("input", () => {
        const newName = nameEl.textContent.trim();
        if (newName) {
            // Sync state update: render() called anywhere after this sees new name
            state.collections[colIndex].name = newName;
            debouncedPersistName();
        }
    });
    nameEl.addEventListener("keydown", e => {
        if (e.key === "Enter") { e.preventDefault(); nameEl.blur(); }
        if (e.key === "Escape") { nameEl.textContent = col.name; nameEl.blur(); }
    });
    // On blur: flush any pending debounced write immediately
    nameEl.addEventListener("blur", () => {
        const newName = nameEl.textContent.trim();
        if (!newName) {
            // Restore if cleared
            nameEl.textContent = col.name;
            return;
        }
        if (newName !== col.name) {
            state.collections[colIndex].name = newName;
        }
        // Flush — cancel debounce timer and write now
        debouncedPersistName.flush?.();
        persistCollections(state.collections);
    });

    const meta = txt("span", "wb-col-card__meta",
        `${colOutfits.length} outfit${colOutfits.length !== 1 ? "s" : ""}`);

    const delBtn = make("button", "wb-btn wb-col-card__delete");
    delBtn.textContent = "×";
    delBtn.title = "Delete collection (outfits are kept)";
    delBtn.onclick = async e => {
        e.stopPropagation();
        state.collections.splice(colIndex, 1);
        if (state.expandedCollectionId === col.id) state.expandedCollectionId = null;
        await persistCollections(state.collections);
        render();
    };

    header.appendChild(chevron);
    header.appendChild(nameEl);
    header.appendChild(meta);
    header.appendChild(delBtn);

    header.addEventListener("click", () => {
        state.expandedCollectionId = isExpanded ? null : col.id;
        render();
    });

    card.appendChild(header);

    // ── Expanded content ─────────────────────────────────────────
    if (isExpanded) {
        const body = make("div", "wb-col-card__body");
        if (!colOutfits.length) {
            body.appendChild(txt("p", "wb-hint",
                "No outfits in this collection yet. Use the + button on a saved outfit to add it."));
        } else {
            const grid = make("div", "wb-saved-grid wb-col-card__grid");
            colOutfits.forEach(outfit => {
                const outfitIdx = state.savedOutfits.findIndex(o => o.id === outfit.id);
                grid.appendChild(buildSavedCard(outfit, outfitIdx));
            });
            body.appendChild(grid);
        }
        card.appendChild(body);
    }

    return card;
}

// ═══════════════════════════════════════════════════════════════
//  🔍  SAVED OUTFIT SEARCH
// ═══════════════════════════════════════════════════════════════

/**
 * Filter saved outfits by state.savedQuery.
 * Searches across: outfit name, mood/occasion/season tags, and for
 * each item in the outfit: display name, brand, color, category,
 * subcategory, and styling tags.
 */
function getFilteredOutfits() {
    const q = lc(state.savedQuery);
    if (!q) return state.savedOutfits.map((o, i) => ({ outfit: o, index: i }));

    return state.savedOutfits
        .map((outfit, index) => ({ outfit, index }))
        .filter(({ outfit }) => {
            // Outfit-level fields: name + tags
            const outfitText = [
                outfit.name || "",
                ...(outfit.tags?.mood     || []),
                ...(outfit.tags?.occasion || []),
                ...(outfit.tags?.season   || []),
            ].map(lc).join(" ");
            if (outfitText.includes(q)) return true;

            // Item-level fields: search across every item in the outfit
            return (outfit.items || []).some(path => {
                const page = pageByPath[path];
                if (!page) return false;
                const itemText = [
                    displayName(page),
                    fk(page, "brand"),
                    fk(page, "category"),
                    fk(page, "subcategory"),
                    ...asList(fk(page, "color")),
                    ...asList(fk(page, "styling_tags")),
                ].map(s => lc(String(s || ""))).join(" ");
                return itemText.includes(q);
            });
        });
}

