// Re-render only the collections list
function renderCollectionsList(list) {
    list.innerHTML = "";
    const q = lc(state.collectionsQuery);
    const visible = state.collections.filter(col => {
        if (!q) return true;
        // Match collection name or any outfit name inside it
        if (lc(col.name).includes(q)) return true;
        return (col.outfitIds || []).some(id => {
            const o = state.savedOutfits.find(o => o.id === id);
            return o && lc(o.name).includes(q);
        });
    });
    if (!visible.length) {
        list.appendChild(txt("p", "wb-hint",
            state.collectionsQuery ? "No collections match." : "No collections yet."));
        return;
    }
    visible.forEach(col => {
        const ci = state.collections.findIndex(c => c.id === col.id);
        list.appendChild(buildCollectionCard(col, ci));
    });
}

// Re-render only the saved outfits grid (called on saved search input)
function renderSavedGrid(grid) {
    grid.innerHTML = "";
    const results = getFilteredOutfits();
    if (!results.length) {
        const empty = txt("p", "wb-hint", state.savedQuery
            ? "No saved outfits match your search."
            : "No saved outfits yet.");
        grid.appendChild(empty);
        return;
    }
    results.forEach(({ outfit, index }) => {
        grid.appendChild(buildSavedCard(outfit, index));
    });
}

// Re-render only the results grid (called on search input to avoid losing focus)
function renderResults(grid) {
    grid.innerHTML = "";
    getFilteredPages().forEach(p => grid.appendChild(buildSearchCard(p)));
    // Update count
    const countEl = ROOT.querySelector(".wb-results-count");
    if (countEl) {
        const filtered = getFilteredPages();
        countEl.textContent =
            `${filtered.length} item${filtered.length !== 1 ? "s" : ""}` +
            (state.selected.length ? `  ·  ${state.selected.length} selected` : "");
    }
}

