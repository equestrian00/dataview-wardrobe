```dataviewjs
// ╔══════════════════════════════════════════════════════════════╗
//  ✨  OUTFIT BUILDER  —  DataviewJS
// ╚══════════════════════════════════════════════════════════════╝

// ═══════════════════════════════════════════════════════════════
//  ⚙️  CONFIGURATION
// ═══════════════════════════════════════════════════════════════

const CONFIG = {
    itemsFolder:   "Items",
    // Note where saved outfits + bridge data are stored (no .md)
    savedNote:     "Saved Outfits",
    // This note's own name — used to persist draft state across re-renders
    builderNote:   "Outfit Builder",
    keys: {
        brand:       "brand",
        style:       "clothingstyle",
        subcategory: "clothingsubcategory",
        category:    "clothingcategory",
        status:      "clothingstatus",
        image:       "image",
        color:       "color",
        styling_tags:"styling_tags",
        size:        "size",
        outfits:       "outfits",        // saved outfits array on Saved Outfits note
        collections:   "collections",     // saved collections array on Saved Outfits note
        pendingImport: "pendingImport",   // bridge key written by Wardrobe Stylist
        draftItems:    "draftItems",      // in-progress item paths on this note
        draftName:     "draftName",       // in-progress outfit name on this note
    },
    // Statuses excluded from search results
    excludeStatuses: ["archive"],
};

// ═══════════════════════════════════════════════════════════════
//  🛠  UTILITIES
// ═══════════════════════════════════════════════════════════════

function fk(p, alias) { return p[CONFIG.keys[alias]]; }
function lc(v) { return String(v || "").toLowerCase().trim(); }
function asList(val) {
    if (!val) return [];
    if (Array.isArray(val)) return val.map(v => String(v).trim()).filter(Boolean);
    return [String(val).trim()].filter(Boolean);
}
function toTitleCase(s) {
    return String(s || "").replace(/\w\S*/g, w =>
        w.charAt(0).toUpperCase() + w.slice(1).toLowerCase());
}
/** Generate a short random ID for stable outfit references */
function makeId() {
    return Date.now().toString(36) + Math.random().toString(36).slice(2, 6);
}

function cleanStyle(val) {
    if (!val) return "";
    const parts = Array.isArray(val) ? val : [val];
    return parts.flatMap(s => String(s).split(","))
        .map(s => s.trim()).filter(Boolean)
        .map(p => p.split(/\s+/).map(toTitleCase).join(" "))
        .join(" ");
}
function displayName(p) {
    const brand  = fk(p, "brand")  ? String(fk(p, "brand")).trim() : "";
    const style  = cleanStyle(fk(p, "style"));
    const subcat = fk(p, "subcategory")
        ? String(fk(p, "subcategory")).split(/\s+/).map(toTitleCase).join(" ") : "";
    return [brand, style, subcat].filter(Boolean).join(" ")
        || p.file.name.replace(/\.md$/, "");
}
function resolveImage(imageProp) {
    if (!imageProp) return null;
    const s  = String(imageProp);
    const wm = s.match(/!?\[\[(.+?)(?:\|[^\]]+)?\]\]/);
    if (wm) {
        const name = wm[1];
        const f = app.vault.getFiles().find(
            fi => fi.name === name || fi.path === name || fi.path.endsWith("/" + name));
        return f ? app.vault.getResourcePath(f) : null;
    }
    if (/^https?:\/\//.test(s)) return s;
    const f2 = app.vault.getAbstractFileByPath(s);
    return f2 ? app.vault.getResourcePath(f2) : null;
}
function make(tag, cls = "") {
    const el = document.createElement(tag);
    if (cls) el.className = cls;
    return el;
}

/**
 * Returns a debounced version of fn that only fires after `wait` ms
 * of silence. Pass leading:true to also fire immediately on the first
 * call (good for clicks — instant response, but ignores rapid repeats).
 */
function debounce(fn, wait = 300, { leading = false } = {}) {
    let timer = null;
    function debounced(...args) {
        const callNow = leading && !timer;
        clearTimeout(timer);
        timer = setTimeout(() => {
            timer = null;
            if (!leading) fn.apply(this, args);
        }, wait);
        if (callNow) fn.apply(this, args);
    }
    // flush(): cancel pending timer and fire immediately
    debounced.flush = function(...args) {
        clearTimeout(timer);
        timer = null;
        fn.apply(this, args);
    };
    return debounced;
}

// Pre-built debounced versions used throughout the UI.
// Pills call render() directly — they're intentional single clicks,
// debouncing them creates a delayed re-render that can stomp on the
// name input or Save button while the user is mid-flow.
// Only the search input and card clicks are debounced.
const debouncedRenderResults = debounce(renderResults, 5000);  // search input typing
function txt(tag, cls, content) {
    const el = make(tag, cls);
    el.textContent = content;
    return el;
}
function showToast(msg, isError = false) {
    const t = make("div", "wb-toast" + (isError ? " wb-toast--error" : ""));
    t.textContent = msg;
    ROOT.appendChild(t);
    setTimeout(() => t.classList.add("wb-toast--out"), 2200);
    setTimeout(() => t.remove(), 2600);
}

// ═══════════════════════════════════════════════════════════════
//  📦  DATA
// ═══════════════════════════════════════════════════════════════

const allPages = dv.pages(`"${CONFIG.itemsFolder}"`).array()
    .filter(p => !CONFIG.excludeStatuses.includes(lc(fk(p, "status"))));

// Collect unique categories for filter pills
const allCategories = [...new Set(
    allPages.map(p => lc(fk(p, "category"))).filter(Boolean)
)].sort();

// Collect all vault-wide mood / occasion / season values for the tag picker
function collectUnique(key) {
    const s = new Set();
    allPages.forEach(p => {
        const val = p[key];
        (Array.isArray(val) ? val : [val]).forEach(v => {
            const t = String(v || "").trim();
            if (t) s.add(toTitleCase(t));
        });
    });
    return [...s].sort();
}
const ALL_MOODS     = collectUnique("mood");
const ALL_OCCASIONS = collectUnique("occasion");
const ALL_SEASONS   = collectUnique("season");

// ── Persistence ──────────────────────────────────────────────

function ensureFile() {
    let file = app.metadataCache.getFirstLinkpathDest(CONFIG.savedNote, "");
    if (file) return Promise.resolve(file);
    return app.vault.create(CONFIG.savedNote + ".md",
        "---\noutfits: []\ncollections: []\n---\n\n# Saved Outfits\n");
}

async function loadSavedOutfits() {
    const page = dv.page(CONFIG.savedNote);
    if (!page) return [];
    const raw = asList(page[CONFIG.keys.outfits]);
    return raw.map(entry => {
        let o = entry;
        if (typeof entry !== "object" || entry === null) {
            try { o = JSON.parse(String(entry)); } catch { return null; }
        }
        // Migration: assign stable id if missing
        if (o && !o.id) o.id = makeId();
        return o;
    }).filter(Boolean);
}

async function persistSavedOutfits(outfits) {
    const file = await ensureFile();
    await app.fileManager.processFrontMatter(file, fm => {
        fm[CONFIG.keys.outfits] = outfits.map(o => JSON.stringify(o));
    });
}

async function loadCollections() {
    const page = dv.page(CONFIG.savedNote);
    if (!page) return [];
    const raw = asList(page[CONFIG.keys.collections]);
    return raw.map(entry => {
        if (typeof entry === "object" && entry !== null) return entry;
        try { return JSON.parse(String(entry)); } catch { return null; }
    }).filter(Boolean);
}

async function persistCollections(collections) {
    const file = await ensureFile();
    await app.fileManager.processFrontMatter(file, fm => {
        fm[CONFIG.keys.collections] = collections.map(c => JSON.stringify(c));
    });
}

/**
 * Read the pendingImport payload left by the Stylist.
 * Does NOT clear it — the user clears it manually via the banner.
 * Returns [] if nothing is pending.
 */
async function loadPendingImport() {
    const page = dv.page(CONFIG.savedNote);
    if (!page) return [];
    const raw = page[CONFIG.keys.pendingImport];
    if (!raw || (Array.isArray(raw) && !raw.length)) return [];
    return (Array.isArray(raw) ? raw : [raw]).map(String).filter(Boolean);
}

// ── Draft persistence ────────────────────────────────────────
// Writes state.selected + state.outfitName to this note's own
// frontmatter so the in-progress outfit survives DataviewJS
// re-executions triggered by vault writes.

async function saveDraft() {
    const file = app.metadataCache.getFirstLinkpathDest(CONFIG.builderNote, "");
    if (!file) return;
    await app.fileManager.processFrontMatter(file, fm => {
        fm[CONFIG.keys.draftItems] = state.selected;
        fm[CONFIG.keys.draftName]  = state.outfitName;
    });
}

async function loadDraft() {
    const page = dv.page(CONFIG.builderNote);
    if (!page) return;
    const items = page[CONFIG.keys.draftItems];
    const name  = page[CONFIG.keys.draftName];
    if (items && Array.isArray(items) && items.length) {
        const validPaths = new Set(allPages.map(p => p.file.path));
        state.selected = items.filter(p => validPaths.has(String(p)));
    }
    if (name) state.outfitName = String(name);
}

async function clearDraft() {
    const file = app.metadataCache.getFirstLinkpathDest(CONFIG.builderNote, "");
    if (!file) return;
    await app.fileManager.processFrontMatter(file, fm => {
        fm[CONFIG.keys.draftItems] = [];
        fm[CONFIG.keys.draftName]  = "";
    });
}

// ═══════════════════════════════════════════════════════════════
//  📋  STATE
// ═══════════════════════════════════════════════════════════════

const state = {
    query:          "",
    filterCategory: "",   // "" = all
    selected:       [],   // file paths of items in current outfit
    outfitName:     "",
    // Tags manually chosen for this outfit
    selectedTags: { mood: [], occasion: [], season: [] },
    // Index into savedOutfits when editing an existing outfit; null = new
    editingIndex:   null,
    savedOutfits:   [],   // loaded async on boot
    savedQuery:     "",   // search string for the saved outfits section
    collections:    [],   // loaded async on boot
    collectionsQuery:        "",
    expandedCollectionId:    null,   // which collection is open
    pendingImport:  [],   // paths waiting to be loaded from Stylist
};

// Page lookup by path
const pageByPath = {};
allPages.forEach(p => { pageByPath[p.file.path] = p; });

// ═══════════════════════════════════════════════════════════════
//  🔍  SEARCH LOGIC
// ═══════════════════════════════════════════════════════════════

function getFilteredPages() {
    const q = lc(state.query);
    return allPages.filter(p => {
        // Category filter
        if (state.filterCategory &&
            lc(fk(p, "category")) !== state.filterCategory) return false;
        // Text search across name, brand, color, tags, subcategory, style
        if (q) {
            const haystack = [
                displayName(p),
                fk(p, "brand"),
                fk(p, "subcategory"),
                ...asList(fk(p, "color")),
                ...asList(fk(p, "styling_tags")),
            ].map(s => lc(String(s || ""))).join(" ");
            if (!haystack.includes(q)) return false;
        }
        return true;
    });
}

